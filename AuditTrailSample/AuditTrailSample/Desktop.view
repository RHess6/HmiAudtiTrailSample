<div id="TcHmiRecipeEdit_1" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiRecipeEdit" data-tchmi-height="215" data-tchmi-height-unit="px" data-tchmi-left="20" data-tchmi-left-unit="px" data-tchmi-top="272" data-tchmi-top-unit="px" data-tchmi-width="446" data-tchmi-width-unit="px">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onRecipeModified",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": false,
        "symbolExpression": "%i%recipe%/i%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%s%TcHmiRecipeManagement.Config::recipeList%/s%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%currentUser%/i%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%s%GetCurrentUser::name%/s%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%currentUserGroup%/i%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%f%%s%TcHmiSrv.GetCurrentUser.groups%/s%.join(',')%/f%"
        },
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "const recipe = TcHmi.Symbol.read('recipe', TcHmi.SymbolType.Internal)",
          "const user = TcHmi.Symbol.read('currentUser', TcHmi.SymbolType.Internal)",
          "const groups = TcHmi.Symbol.read('currentUserGroup', TcHmi.SymbolType.Internal)",
          "TcHmi.Server.AuditTrail.createAuditLogEntryEx(",
          "    {",
          "        name: 'recipe modified/saved',",
          "        contextDomain: 'TcHmiRecipeManagement',",
          "        comment: '',",
          "        data: { oldRecipes: recipe, changedRecipe: ctx.args[0], user: user, userGroups: groups}",
          "    },",
          "    null,",
          "    (data) => {",
          "    }",
          ");"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  },
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onEditStarted",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%recipe%/i%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%s%TcHmiRecipeManagement.Config::recipeList%/s%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%currentUser%/i%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%s%GetCurrentUser::name%/s%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%currentUserGroup%/i%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%f%%s%TcHmiSrv.GetCurrentUser.groups%/s%.join(',')%/f%"
        },
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "const recipe = TcHmi.Symbol.read('recipe', TcHmi.SymbolType.Internal)",
          "const user = TcHmi.Symbol.read('currentUser', TcHmi.SymbolType.Internal)",
          "const groups = TcHmi.Symbol.read('currentUserGroup', TcHmi.SymbolType.Internal)",
          "",
          "TcHmi.Server.AuditTrail.createAuditLogEntryEx(",
          "    {",
          "        name: 'Recipe selected to be edited',",
          "        contextDomain: 'TcHmiRecipeManagement',",
          "        comment: '',",
          "        data: { recipeSelected: ctx.args[0], oldRecipes: recipe, user: user, userGroups: groups}",
          "    },",
          "    null,",
          "    (data) => {",
          "    }",
          ");"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  },
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onRecipeCreated",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": false,
        "symbolExpression": "%i%recipe%/i%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%s%TcHmiRecipeManagement.Config::recipeList%/s%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%currentUser%/i%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%s%GetCurrentUser::name%/s%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%currentUserGroup%/i%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%f%%s%TcHmiSrv.GetCurrentUser.groups%/s%.join(',')%/f%"
        },
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "const user = TcHmi.Symbol.read('currentUser', TcHmi.SymbolType.Internal)",
          "const groups = TcHmi.Symbol.read('currentUserGroup', TcHmi.SymbolType.Internal)",
          "TcHmi.Server.AuditTrail.createAuditLogEntryEx(",
          "    {",
          "        name: 'recipe created',",
          "        contextDomain: 'TcHmiRecipeManagement',",
          "        comment: '',",
          "        data: { createdRecipe: ctx.args[0], oldRecipes: recipe, user: user, userGroups: groups}",
          "    },",
          "    null,",
          "    (data) => {",
          "    }",
          ");"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  },
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onRecipeActivated",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%currentUser%/i%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%s%GetCurrentUser::name%/s%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%currentUserGroup%/i%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%f%%s%TcHmiSrv.GetCurrentUser.groups%/s%.join(',')%/f%"
        },
        "asyncWait": true
      },
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "const recipe = TcHmi.Symbol.read('recipe', TcHmi.SymbolType.Internal)",
          "const user = TcHmi.Symbol.read('currentUser', TcHmi.SymbolType.Internal)",
          "const groups = TcHmi.Symbol.read('currentUserGroup', TcHmi.SymbolType.Internal)",
          "TcHmi.Server.AuditTrail.createAuditLogEntryEx(",
          "    {",
          "        name: 'recipe activated',",
          "        contextDomain: 'TcHmiRecipeManagement',",
          "        comment: '',",
          "        data: { activatedRecipe: ctx.args[0], oldRecipes: recipe, user: user, userGroups: groups}",
          "    },",
          "    null,",
          "    (data) => {",
          "    }",
          ");"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
