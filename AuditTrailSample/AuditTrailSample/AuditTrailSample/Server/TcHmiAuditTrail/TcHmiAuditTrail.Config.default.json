{
    "auditTrailSymbols": {
        "ADS.PLC1.MAIN.tempVar": {
            "commentRequired": false,
            "enabled": true,
            "mappingData": [
                "OPTIONS"
            ],
            "symbolData": ""
        },
        "ADS.PLC1.gvl.teas.Name": {
            "commentRequired": false,
            "enabled": true,
            "mappingData": [],
            "symbolData": ""
        },
        "ADS.PLC1.gvl.teas.Price": {
            "commentRequired": false,
            "enabled": true,
            "mappingData": [],
            "symbolData": ""
        },
        "ADS.PLC1.gvl.teas.ingredients": {
            "commentRequired": false,
            "enabled": true,
            "mappingData": [],
            "symbolData": ""
        },
        "ADS.PLC1.gvl.test": {
            "commentRequired": false,
            "enabled": true,
            "mappingData": [],
            "symbolData": ""
        }
    },
    "blockCommandsOnError": false,
    "configPageMaxEntries": 200,
    "createEventOnAudit": false,
    "databaseConnection": {
        "connectionString": "Server=localhost; Port=5432; Database=postgres; Uid=postgres; Pwd=@{password};Timeout=10;",
        "password": "",
        "tableId": 1
    },
    "databaseMaxEntries": 15000,
    "eventFilters": {
        "auditTrailDatabaseReset": {
            "enabled": true,
            "filter": [
                {
                    "comparator": "==",
                    "path": "name",
                    "value": "auditTrailDatabaseReset"
                }
            ]
        },
        "auditTrailErrorLogMessage": {
            "enabled": true,
            "filter": [
                {
                    "comparator": "==",
                    "path": "name",
                    "value": "auditTrailErrorLogMessage"
                }
            ]
        },
        "authFailed": {
            "enabled": true,
            "filter": [
                {
                    "comparator": "==",
                    "path": "name",
                    "value": "AUTH_FAILED"
                },
                {
                    "logic": "AND"
                },
                {
                    "comparator": "==",
                    "path": "payload::params::persistPreviousSession",
                    "value": false
                }
            ]
        },
        "customAuditTrailLogEntry": {
            "enabled": true,
            "filter": [
                {
                    "comparator": "==",
                    "path": "name",
                    "value": "AuditLogEntry"
                }
            ]
        },
        "login": {
            "enabled": true,
            "filter": [
                {
                    "comparator": "==",
                    "path": "name",
                    "value": "LOGIN_LOG"
                },
                {
                    "logic": "AND"
                },
                {
                    "comparator": "==",
                    "path": "payload::params::persistPreviousSession",
                    "value": false
                }
            ]
        },
        "logout": {
            "enabled": true,
            "filter": [
                {
                    "comparator": "==",
                    "path": "name",
                    "value": "LOGOUT_LOG"
                },
                {
                    "logic": "AND"
                },
                {
                    "comparator": "!=",
                    "path": "payload::params::reason",
                    "value": "PersistPreviousSession"
                }
            ]
        }
    },
    "maxErrorLogSize": 2097152,
    "minCommentLength": 0,
    "remainingDatabaseEntriesHintLimit": 10,
    "signatureKey": ""
}